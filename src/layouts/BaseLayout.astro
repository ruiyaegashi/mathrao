---
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
}

const { title = 'Mathrao' } = Astro.props;
const fullTitle = title === 'Mathrao' ? title : `${title} | Mathrao`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/">Mathrao</a>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
  }

  .site-header,
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  pre,
  table,
  article .katex-display,
  article .katex-scroll {
    max-width: 100%;
    overflow-x: auto;
  }

  article .katex {
    white-space: nowrap;
  }

  .legacy-overrule {
    border-left: 2px solid;
    padding-left: 1rem;
  }

  .legacy-wpex {
    border: 1px solid;
    padding: 0.5rem 1rem;
  }
</style>
