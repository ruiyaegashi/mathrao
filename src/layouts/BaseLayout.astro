---
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '数学を学ぶための教材サイト' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Mathrao</title>
  </head>
  <body>
    <header>
      <a class="site-name" href="/">Mathrao</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif; line-height: 1.8; }
  body { max-width: 48rem; margin: 0 auto; padding: 0 1.25rem 4rem; color: #1f2937; background: #fff; }
  header { padding: 1.5rem 0; border-bottom: 1px solid #d1d5db; }
  main { padding-top: 2rem; }
  .site-name { color: inherit; font-size: 1.2rem; font-weight: 700; text-decoration: none; }
  a { color: #155e75; }
  h1, h2, h3 { line-height: 1.4; }
  .katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.25rem 0; }
</style>
