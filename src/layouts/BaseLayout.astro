---
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '数学を学ぶための教材サイト' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Mathrao</title>
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7781274978364717"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header>
      <a class="site-name" href="/">Mathrao</a>
      <nav class="site-nav" aria-label="主な分野">
        <a href="/browse/junior-high/">中学数学</a>
        <a href="/browse/high-school/">高校数学</a>
        <a href="/browse/theorems/">定理・公式・証明</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif; line-height: 1.8; }
  body { max-width: 48rem; margin: 0 auto; padding: 0 1.25rem 4rem; color: #1f2937; background: #fff; }
  header { padding: 1.5rem 0; border-bottom: 1px solid #d1d5db; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  main { padding-top: 2rem; }
  .site-name { color: inherit; font-size: 1.2rem; font-weight: 700; text-decoration: none; }
  .site-nav { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; }
  .site-nav a { white-space: nowrap; }
  a { color: #155e75; }
  h1, h2, h3 { line-height: 1.4; }
  /* Keep long math within its own scroll area without changing the formula. */
  article .katex-display { max-width: 100%; overflow-x: auto; overflow-y: hidden; padding: 0.25rem 0; }
  article .katex { white-space: nowrap; }
  article .katex-scroll { display: inline-block; max-width: 100%; overflow-x: auto; overflow-y: hidden; white-space: nowrap; vertical-align: middle; }
  .legacy-overrule { border-left: 2px solid #9ca3af; padding: 0.25rem 0 0.25rem 1rem; margin: 1rem 0; }
  .legacy-wpex { border: 1px solid #d1d5db; padding: 0.5rem 1rem; margin: 1rem 0; }
  .legacy-wpex summary { cursor: pointer; }
  .amazon-products { margin: 3rem 0 1rem; padding: 1rem; border: 1px solid #d1d5db; }
  .amazon-products h2 { font-size: 1.1rem; margin-top: 0; }
  .amazon-disclosure { font-size: 0.8rem; color: #4b5563; }
  .amazon-product-list { display: grid; gap: 0.75rem; }
  .amazon-product-card { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 1rem; align-items: center; padding: 0.75rem; border: 1px solid #d1d5db; text-decoration: none; }
  .amazon-product-card img { grid-row: 1 / 3; width: 96px; max-height: 120px; object-fit: contain; }
  .amazon-product-card small { color: #4b5563; }
</style>
