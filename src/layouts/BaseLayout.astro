---
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mathrao',
  description = '数学を学ぶための教材サイト',
} = Astro.props;
const fullTitle = title === 'Mathrao' ? title : `${title} | Mathrao`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/"><img src="/media/logo_wide.png" alt="Mathrao" width="600" height="60" /></a>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
  }

  .site-header,
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  pre,
  table,
  article .katex-display,
  article .katex-scroll {
    max-width: 100%;
    overflow-x: auto;
  }

  article .katex {
    white-space: nowrap;
  }

  .article-note {
    border-left: 2px solid;
    padding-left: 1rem;
  }

  .article-details {
    border: 1px solid;
    padding: 0.5rem 1rem;
  }
</style>
