---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-title">ページが見つかりません</h1>
    <p>URLが正しいか確認してください。記事一覧から読みたい記事を探すこともできます。</p>
    <a class="not-found-link" href="/">記事一覧へ戻る <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(2rem, 7vw, 4rem);
    background: #fff;
    border: 1px solid #dce5e5;
    border-radius: 16px;
    text-align: center;
  }

  .not-found-code {
    margin: 0;
    color: #548b8e;
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .not-found h1 {
    margin: 1rem 0;
    font-size: clamp(1.4rem, 4vw, 1.9rem);
    line-height: 1.5;
  }

  .not-found p:not(.not-found-code) {
    color: #52676f;
  }

  .not-found-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.6rem 1.3rem;
    background: #096b70;
    color: #fff;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
  }

  .not-found-link:hover {
    color: #fff;
    background: #075156;
  }

  @media (max-width: 680px) {
    .not-found {
      padding: 2rem 1.2rem;
    }
  }
</style>
