---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RakutenBookCard from '../components/RakutenBookCard.astro';
import bookSelections from '../data/rakuten-book-selections.json';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

interface Props {
  entry: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const entries = (await getCollection('articles')).filter((entry) => entry.data.status === 'published');
  return entries.map((entry) => ({
    params: { path: entry.data.path!.replace(/^\/+|\/+$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Use an article-specific description. Avoid selecting tables, bare links,
// or formula fragments as the snippet shown in search results.
const isFormulaReference = (entry.data.path ?? '').startsWith('/basics-of-');
const summaryText = isFormulaReference ? undefined : (entry.body ?? '')
  .replace(/<!--[\s\S]*?-->/g, ' ')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter((paragraph) =>
    paragraph.length > 0 &&
    !/^#{1,6}\s/.test(paragraph) &&
    !/^<(?:table|tr|td|th|script|style|svg)\b/i.test(paragraph) &&
    !/^(?:\[[^\]]+\]\([^)]+\)\s*)+$/.test(paragraph),
  )
  .map((paragraph) => paragraph
    .replace(/<[^>]+>/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\[旧埋め込み\]/g, ' ')
    .replace(/\$\$[\s\S]*?\$\$|\$[^$\n]*\$/g, ' ')
    .replace(/[`*_]/g, '')
    .replace(/\s+/g, ' ')
    .trim())
  .find((paragraph) =>
    (paragraph.match(/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/gu) ?? []).length >= 20 &&
    (paragraph.match(/[0-9０-９]/g) ?? []).length <= paragraph.length * 0.2,
  );
const descriptionText = `${entry.data.title}。${summaryText ?? 'Mathraoで公開している算数・数学の学習記事です。'}`;
const articleDescription = Array.from(descriptionText).slice(0, 140).join('') +
  (Array.from(descriptionText).length > 140 ? '…' : '');

// Only approved article, ISBN and legacy position references are kept in Git.
// API-derived products live in a private, temporary CI build file.
const selectedBooks = bookSelections.selections.filter((s) => s.articlePath === entry.data.path);
type Book = { isbn: string; title: string; imageUrl: string; affiliateUrl: string; fetchedAt: string; };
const bookGroups: { slotIndex: number; slotEnd: number; books: Book[] }[] = [];
if (selectedBooks.length) {
  try {
    const raw = await readFile(join(process.cwd(), 'src/generated/rakuten-books.json'), 'utf8');
    const data = JSON.parse(raw);
    const validHttps = (value: unknown) => {
      try { return typeof value === 'string' && new URL(value).protocol === 'https:'; }
      catch { return false; }
    };
    if (data.schemaVersion === 2) {
      for (const selected of selectedBooks) {
        const books: Book[] = [];
        for (const isbn of selected.isbns) {
          const book = data.books?.[isbn];
          if (!book || book.isbn !== isbn ||
              typeof book.title !== 'string' || !book.title ||
              !validHttps(book.imageUrl) || !validHttps(book.affiliateUrl) ||
              !Number.isFinite(Date.parse(book?.fetchedAt ?? ''))) {
            books.length = 0;
            break; // Suppress an incomplete approved multi-volume group.
          }
          books.push(book);
        }
        if (books.length === selected.isbns.length) {
          const slotEnd = "legacySlotEnd" in selected && typeof selected.legacySlotEnd === "number"
            ? selected.legacySlotEnd : selected.legacySlotIndex;
          bookGroups.push({ slotIndex: selected.legacySlotIndex, slotEnd, books });
        }
      }
    }
  } catch {
    // Cloudflare's automatic production build must never overwrite approved cards with a bookless build.
    if (process.env.CF_PAGES === '1' && process.env.CF_PAGES_BRANCH === 'main') {
      throw new Error('Production Pages Git build has no approved Rakuten snapshot; deployment blocked');
    }
    // Local builds may omit the temporary API snapshot.
  }
}

---

<BaseLayout title={entry.data.title} description={articleDescription}>
  <article class="article-page" data-article-content>
    <header class="article-header">
      <a class="article-back-link" href="/">← 記事一覧へ</a>
      {entry.data.published_at && (
        <p class="article-date">
          <time datetime={entry.data.published_at.slice(0, 10)}>
            {entry.data.published_at.slice(0, 10)}
          </time>
        </p>
      )}
      <h1>{entry.data.title}</h1>
    </header>
    {entry.data.featured_image && (
      <figure class="article-featured">
        <img src={entry.data.featured_image} alt="" loading="lazy" decoding="async" />
      </figure>
    )}
    <div class="article-body">
      <Content />
    </div>
    <nav class="article-bottom-nav" aria-label="記事を読み終えた方へ">
      <a href="/">← 記事一覧へ戻る</a>
    </nav>
  </article>
  {bookGroups.map((group) => (
    <template data-rakuten-book-slot data-slot-index={group.slotIndex} data-slot-end={group.slotEnd}>
      {group.books.map((book) => (
        <RakutenBookCard
          title={book.title}
          imageUrl={book.imageUrl}
          affiliateUrl={book.affiliateUrl}
          isbn={book.isbn}
        />
      ))}
    </template>
  ))}
</BaseLayout>

<style>
  .article-page {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(1.4rem, 4vw, 3rem);
    background: #fff;
    border: 1px solid #e2e9e9;
    border-radius: 16px;
    box-shadow: 0 6px 24px rgba(31, 57, 64, 0.03);
  }

  .article-header {
    padding-bottom: 1.5rem;
    margin-bottom: 1.7rem;
    border-bottom: 1px solid #e2e9e9;
  }

  .article-back-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .article-back-link:hover {
    text-decoration: underline;
  }

  .article-date {
    margin: 1.4rem 0 0.55rem;
    color: #64777d;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .article-header h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.65rem, 4.2vw, 2.2rem);
    line-height: 1.5;
  }

  .article-featured {
    margin: 0 0 2rem;
    text-align: center;
  }

  .article-featured img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .article-body {
    min-width: 0;
    font-size: clamp(1rem, 1.1vw + 0.8rem, 1.075rem);
    line-height: 1.95;
  }

  .article-bottom-nav {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e9e9;
    font-weight: 600;
  }

  @media (max-width: 680px) {
    .article-page {
      padding: 1.5rem 1.1rem 2rem;
      border-radius: 12px;
    }

    .article-header {
      margin-bottom: 1.4rem;
    }

    .article-date {
      margin-top: 1rem;
    }
  }
</style>
<script>
  import renderMathInElement from 'katex/contrib/auto-render';

  // Reference the original, untouched 1-based article placeholders.
  const placeholders = Array.from(document.querySelectorAll<HTMLElement>('.article-body .article-embed-placeholder'));
  const templates = document.querySelectorAll<HTMLTemplateElement>('template[data-rakuten-book-slot]');
  for (const template of templates) {
    const start = Number(template.dataset.slotIndex);
    const end = Number(template.dataset.slotEnd);
    if (!Number.isInteger(start) || !Number.isInteger(end) ||
        start < 1 || end < start || end > placeholders.length) continue;
    const target = placeholders[start - 1];
    if (!target || !target.isConnected) continue;
    const cards = Array.from(template.content.querySelectorAll<HTMLElement>('[data-rakuten-book-card]'));
    if (!cards.length) continue;
    const inserted = cards.map(card => {
      const copy = document.importNode(card, true);
      copy.hidden = false;
      return copy;
    });
    target.replaceWith(...inserted);
    // Previously separate positions 30-32 now describe two current series books.
    for (let i = start + 1; i <= end; i++) placeholders[i - 1]?.remove();
  }

  const article = document.querySelector<HTMLElement>('[data-article-content]');
  if (article) {
    renderMathInElement(article, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '\\[', right: '\\]', display: true },
        { left: '$', right: '$', display: false },
        { left: '\\(', right: '\\)', display: false },
      ],
      ignoredClasses: ['katex', 'katex-display'],
      throwOnError: false,
    });

    const updateMathOverflow = () => {
      for (const math of article.querySelectorAll<HTMLElement>('.katex')) {
        if (math.closest('.katex-display')) continue;
        const container = math.closest<HTMLElement>('p, li, blockquote, td, th, div, aside, section, article');
        if (!container) continue;
        math.classList.toggle(
          'katex-scroll',
          math.getBoundingClientRect().width > container.clientWidth + 4 ||
            math.scrollWidth > container.clientWidth + 4,
        );
      }
    };

    updateMathOverflow();
    window.addEventListener('resize', updateMathOverflow, { passive: true });
  }
</script>
