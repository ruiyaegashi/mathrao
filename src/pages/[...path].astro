---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RakutenBookCard from '../components/RakutenBookCard.astro';
import bookSelections from '../data/rakuten-book-selections.json';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

interface Props {
  entry: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const entries = (await getCollection('articles')).filter((entry) => entry.data.status === 'published');
  return entries.map((entry) => ({
    params: { path: entry.data.path!.replace(/^\/+|\/+$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Use an article-specific description. Avoid selecting tables, bare links,
// or formula fragments as the snippet shown in search results.
const isFormulaReference = (entry.data.path ?? '').startsWith('/basics-of-');
const summaryText = isFormulaReference ? undefined : (entry.body ?? '')
  .replace(/<!--[\s\S]*?-->/g, ' ')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter((paragraph) =>
    paragraph.length > 0 &&
    !/^#{1,6}\s/.test(paragraph) &&
    !/^<(?:table|tr|td|th|script|style|svg)\b/i.test(paragraph) &&
    !/^(?:\[[^\]]+\]\([^)]+\)\s*)+$/.test(paragraph),
  )
  .map((paragraph) => paragraph
    .replace(/<[^>]+>/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\[旧埋め込み\]/g, ' ')
    .replace(/\$\$[\s\S]*?\$\$|\$[^$\n]*\$/g, ' ')
    .replace(/[`*_]/g, '')
    .replace(/\s+/g, ' ')
    .trim())
  .find((paragraph) =>
    (paragraph.match(/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/gu) ?? []).length >= 20 &&
    (paragraph.match(/[0-9０-９]/g) ?? []).length <= paragraph.length * 0.2,
  );
const descriptionText = `${entry.data.title}。${summaryText ?? 'Mathraoで公開している算数・数学の学習記事です。'}`;
const articleDescription = Array.from(descriptionText).slice(0, 140).join('') +
  (Array.from(descriptionText).length > 140 ? '…' : '');

// Pilot only. The JSON file is produced during a manual, secret-backed CI test.
// Ordinary builds without the file keep the existing article unchanged.
const selection = bookSelections.selections.find((item) => item.articlePath === entry.data.path);
let pilotBook: {
  isbn: string;
  title: string;
  imageUrl: string;
  affiliateUrl: string;
  fetchedAt: string;
  expiresAt: string;
} | null = null;
if (selection) {
  try {
    const json = await readFile(join(process.cwd(), 'src/generated/rakuten-books.json'), 'utf8');
    const data = JSON.parse(json);
    const candidate = data.books?.[selection.isbn];
    const from = Date.parse(candidate?.fetchedAt ?? '');
    const until = Date.parse(candidate?.expiresAt ?? '');
    const now = Date.now();
    const validHttps = (value: unknown) => {
      try { return typeof value === 'string' && new URL(value).protocol === 'https:'; }
      catch { return false; }
    };
    if (candidate && candidate.isbn === selection.isbn &&
        typeof candidate.title === 'string' && candidate.title.length > 0 &&
        validHttps(candidate.imageUrl) && validHttps(candidate.affiliateUrl) &&
        Number.isFinite(from) && Number.isFinite(until) &&
        from <= now && now < until && until - from <= 7 * 24 * 60 * 60 * 1000) {
      pilotBook = candidate;
    }
  } catch {
    // No generated data: do not expose a stale or unauthenticated book card.
  }
}

---

<BaseLayout title={entry.data.title} description={articleDescription}>
  <article class="article-page" data-article-content>
    <header class="article-header">
      <a class="article-back-link" href="/">← 記事一覧へ</a>
      {entry.data.published_at && (
        <p class="article-date">
          <time datetime={entry.data.published_at.slice(0, 10)}>
            {entry.data.published_at.slice(0, 10)}
          </time>
        </p>
      )}
      <h1>{entry.data.title}</h1>
    </header>
    {entry.data.featured_image && (
      <figure class="article-featured">
        <img src={entry.data.featured_image} alt="" loading="lazy" decoding="async" />
      </figure>
    )}
    <div class="article-body">
      <Content />
    </div>
    <nav class="article-bottom-nav" aria-label="記事を読み終えた方へ">
      <a href="/">← 記事一覧へ戻る</a>
    </nav>
  </article>
  {pilotBook && (
    <template data-rakuten-book-pilot>
      <RakutenBookCard
        title={pilotBook.title}
        imageUrl={pilotBook.imageUrl}
        affiliateUrl={pilotBook.affiliateUrl}
        isbn={pilotBook.isbn}
        expiresAt={pilotBook.expiresAt}
      />
    </template>
  )}
</BaseLayout>

<style>
  .article-page {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(1.4rem, 4vw, 3rem);
    background: #fff;
    border: 1px solid #e2e9e9;
    border-radius: 16px;
    box-shadow: 0 6px 24px rgba(31, 57, 64, 0.03);
  }

  .article-header {
    padding-bottom: 1.5rem;
    margin-bottom: 1.7rem;
    border-bottom: 1px solid #e2e9e9;
  }

  .article-back-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .article-back-link:hover {
    text-decoration: underline;
  }

  .article-date {
    margin: 1.4rem 0 0.55rem;
    color: #64777d;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .article-header h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.65rem, 4.2vw, 2.2rem);
    line-height: 1.5;
  }

  .article-featured {
    margin: 0 0 2rem;
    text-align: center;
  }

  .article-featured img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .article-body {
    min-width: 0;
    font-size: clamp(1rem, 1.1vw + 0.8rem, 1.075rem);
    line-height: 1.95;
  }

  .article-bottom-nav {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e9e9;
    font-weight: 600;
  }

  @media (max-width: 680px) {
    .article-page {
      padding: 1.5rem 1.1rem 2rem;
      border-radius: 12px;
    }

    .article-header {
      margin-bottom: 1.4rem;
    }

    .article-date {
      margin-top: 1rem;
    }
  }
</style>
<script>
  import renderMathInElement from 'katex/contrib/auto-render';

  // Insert only the pilot card at its approved legacy slot.
  // Hidden-by-default markup stays hidden without JavaScript.
  const pilotSlot = document.querySelector<HTMLElement>('[data-rakuten-slot="reference-23"]');
  const bookTemplate = document.querySelector<HTMLTemplateElement>('template[data-rakuten-book-pilot]');
  if (pilotSlot && bookTemplate) {
    const sourceCard = bookTemplate.content.querySelector<HTMLElement>('[data-rakuten-book-card]');
    const expiresAt = Date.parse(sourceCard?.dataset.expiresAt ?? '');
    const remaining = expiresAt - Date.now();
    if (sourceCard && Number.isFinite(expiresAt) && remaining > 0 && remaining <= 7 * 24 * 60 * 60 * 1000) {
      const visibleCard = document.importNode(sourceCard, true);
      visibleCard.hidden = false;
      pilotSlot.replaceWith(visibleCard);
      window.setTimeout(() => visibleCard.remove(), remaining);
    } else {
      pilotSlot.remove();
    }
  }


  const article = document.querySelector<HTMLElement>('[data-article-content]');
  if (article) {
    renderMathInElement(article, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '\\[', right: '\\]', display: true },
        { left: '$', right: '$', display: false },
        { left: '\\(', right: '\\)', display: false },
      ],
      ignoredClasses: ['katex', 'katex-display'],
      throwOnError: false,
    });

    const updateMathOverflow = () => {
      for (const math of article.querySelectorAll<HTMLElement>('.katex')) {
        if (math.closest('.katex-display')) continue;
        const container = math.closest<HTMLElement>('p, li, blockquote, td, th, div, aside, section, article');
        if (!container) continue;
        math.classList.toggle(
          'katex-scroll',
          math.getBoundingClientRect().width > container.clientWidth + 4 ||
            math.scrollWidth > container.clientWidth + 4,
        );
      }
    };

    updateMathOverflow();
    window.addEventListener('resize', updateMathOverflow, { passive: true });
  }
</script>
