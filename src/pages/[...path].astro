---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const entries = (await getCollection('articles')).filter((entry) => entry.data.status === 'published');
  return entries.map((entry) => ({
    params: { path: entry.data.path!.replace(/^\/+|\/+$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Create a relevant page description from the article's own text.
// Keep the original Markdown and mathematical content unchanged.
const paragraphs = (entry.body ?? '')
  .replace(/<!--[\s\S]*?-->/g, ' ')
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter((paragraph) => paragraph && !/^#{1,6}\s/.test(paragraph))
  .map((paragraph) => paragraph
    .replace(/<[^>]+>/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/\[旧埋め込み\]/g, ' ')
    .replace(/\$\$[\s\S]*?\$\$|\$[^$\n]*\$/g, ' ')
    .replace(/[\x60*_]/g, '')
    .replace(/\s+/g, ' ')
    .trim())
  .filter((paragraph) => paragraph.length >= 35 && !/^\//.test(paragraph));
const descriptionText = paragraphs[0] ?? `${entry.data.title}について学べるMathraoの数学教材・記事です。`;
const articleDescription = Array.from(descriptionText).slice(0, 125).join('') +
  (Array.from(descriptionText).length > 125 ? '…' : '');
---

<BaseLayout title={entry.data.title} description={articleDescription}>
  <article class="article-page" data-article-content>
    <header class="article-header">
      <a class="article-back-link" href="/">← 記事一覧へ</a>
      {entry.data.published_at && (
        <p class="article-date">
          <time datetime={entry.data.published_at.slice(0, 10)}>
            {entry.data.published_at.slice(0, 10)}
          </time>
        </p>
      )}
      <h1>{entry.data.title}</h1>
    </header>
    {entry.data.featured_image && (
      <figure class="article-featured">
        <img src={entry.data.featured_image} alt="" loading="lazy" decoding="async" />
      </figure>
    )}
    <div class="article-body">
      <Content />
    </div>
    <nav class="article-bottom-nav" aria-label="記事を読み終えた方へ">
      <a href="/">← 記事一覧へ戻る</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .article-page {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(1.4rem, 4vw, 3rem);
    background: #fff;
    border: 1px solid #e2e9e9;
    border-radius: 16px;
    box-shadow: 0 6px 24px rgba(31, 57, 64, 0.03);
  }

  .article-header {
    padding-bottom: 1.5rem;
    margin-bottom: 1.7rem;
    border-bottom: 1px solid #e2e9e9;
  }

  .article-back-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .article-back-link:hover {
    text-decoration: underline;
  }

  .article-date {
    margin: 1.4rem 0 0.55rem;
    color: #64777d;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .article-header h1 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.65rem, 4.2vw, 2.2rem);
    line-height: 1.5;
  }

  .article-featured {
    margin: 0 0 2rem;
    text-align: center;
  }

  .article-featured img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .article-body {
    min-width: 0;
    font-size: clamp(1rem, 1.1vw + 0.8rem, 1.075rem);
    line-height: 1.95;
  }

  .article-bottom-nav {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e9e9;
    font-weight: 600;
  }

  @media (max-width: 680px) {
    .article-page {
      padding: 1.5rem 1.1rem 2rem;
      border-radius: 12px;
    }

    .article-header {
      margin-bottom: 1.4rem;
    }

    .article-date {
      margin-top: 1rem;
    }
  }
</style>
<script>
  import renderMathInElement from 'katex/contrib/auto-render';

  const article = document.querySelector<HTMLElement>('[data-article-content]');
  if (article) {
    renderMathInElement(article, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '\\[', right: '\\]', display: true },
        { left: '$', right: '$', display: false },
        { left: '\\(', right: '\\)', display: false },
      ],
      ignoredClasses: ['katex', 'katex-display'],
      throwOnError: false,
    });

    const updateMathOverflow = () => {
      for (const math of article.querySelectorAll<HTMLElement>('.katex')) {
        if (math.closest('.katex-display')) continue;
        const container = math.closest<HTMLElement>('p, li, blockquote, td, th, div, aside, section, article');
        if (!container) continue;
        math.classList.toggle(
          'katex-scroll',
          math.getBoundingClientRect().width > container.clientWidth + 4 ||
            math.scrollWidth > container.clientWidth + 4,
        );
      }
    };

    updateMathOverflow();
    window.addEventListener('resize', updateMathOverflow, { passive: true });
  }
</script>
