---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => (b.data.published_at ?? '').localeCompare(a.data.published_at ?? ''));

const articlePath = (entry: (typeof articles)[number]) => entry.data.path!;
---
<BaseLayout>
  <section class="home-intro" aria-labelledby="home-title">
    <p class="home-eyebrow">Mathrao</p>
    <h1 id="home-title">数学を、もっと身近に。</h1>
    <p class="home-description">
      算数・数学の考え方や、毎日の学びに役立つ記事をまとめています。
    </p>
  </section>

  <section class="article-index" aria-labelledby="article-index-title">
    <div class="index-heading">
      <h2 id="article-index-title">記事一覧</h2>
      <p class="article-count">公開中 {articles.length} 件</p>
    </div>
    <ul class="article-list">
      {articles.map((entry) => (
        <li class="article-list-item">
          <a class="article-list-link" href={articlePath(entry)}>
            <span class="article-list-title">{entry.data.title}</span>
            {entry.data.published_at && (
              <time class="article-list-date" datetime={entry.data.published_at.slice(0, 10)}>
                {entry.data.published_at.slice(0, 10)}
              </time>
            )}
            <span class="article-list-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .home-intro {
    padding: clamp(1.6rem, 4vw, 3.5rem);
    background: #eaf3f2;
    border: 1px solid #d6e7e5;
    border-radius: 18px;
  }

  .home-eyebrow {
    margin: 0 0 0.5rem;
    color: #226a70;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .home-intro h1 {
    margin: 0;
    color: #1b343c;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .home-description {
    max-width: 44rem;
    margin: 1rem 0 0;
    color: #496168;
    line-height: 1.9;
  }

  .article-index {
    margin-top: 2.5rem;
  }

  .index-heading {
    display: flex;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin: 0 0 1rem;
  }

  .index-heading h2 {
    margin: 0;
    color: #243943;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
  }

  .article-count {
    margin: 0;
    color: #5c7078;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid #dce5e5;
    border-radius: 14px;
  }

  .article-list-item + .article-list-item {
    border-top: 1px solid #edf0f1;
  }

  .article-list-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1.2rem;
    align-items: center;
    gap: 0.6rem 1.2rem;
    padding: 1.05rem 1.4rem;
    color: #23404b;
    text-decoration: none;
  }

  .article-list-link:hover,
  .article-list-link:focus-visible {
    background: #f1f8f7;
    color: #075e64;
  }

  .article-list-title {
    min-width: 0;
    overflow-wrap: anywhere;
    font-weight: 600;
    line-height: 1.65;
  }

  .article-list-date {
    color: #61747b;
    font-size: 0.83rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .article-list-arrow {
    color: #2d787a;
    font-size: 1.1rem;
    text-align: right;
  }

  @media (max-width: 680px) {
    .home-intro {
      padding: 1.5rem 1.2rem;
      border-radius: 12px;
    }

    .article-index {
      margin-top: 2rem;
    }

    .article-list-link {
      grid-template-columns: minmax(0, 1fr) 1.2rem;
      gap: 0.25rem 0.65rem;
      padding: 0.95rem 1rem;
    }

    .article-list-title {
      grid-column: 1;
      grid-row: 1;
    }

    .article-list-date {
      grid-column: 1;
      grid-row: 2;
    }

    .article-list-arrow {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
