---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entriesForSection, getPublishedLegacy, sections } from '../lib/catalog';

const entries = await getPublishedLegacy();
---

<BaseLayout title="ホーム" description="中学・高校数学の学習サイト">
  <h1>Mathrao</h1>
  <p class="lead">中学・高校数学の学習サイト</p>
  <p>中学校・高校の数学を、基本事項から定理・公式・証明まで体系的にまとめています。</p>

  <h2>分野から探す</h2>
  <ul class="section-list">
    {sections.map((section) => (
      <li>
        <a href={`/browse/${section.slug}/`}>{section.title}</a>
        <span>{entriesForSection(entries, section).length}件</span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .lead { font-size: 1.2rem; font-weight: 600; }
  .section-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 0.65rem 1.5rem; }
  .section-list li { border-bottom: 1px solid #d1d5db; padding: 0.35rem 0 0.6rem; display: flex; justify-content: space-between; gap: 1rem; }
  .section-list span { color: #526171; white-space: nowrap; }
</style>
